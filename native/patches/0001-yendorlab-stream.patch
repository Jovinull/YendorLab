+static void lab_string(const char *value) {
+    putchar('"');
+    for (const unsigned char *p = (const unsigned char *) value; *p; p++) {
+        if (*p == '"' || *p == '\\') {
+            putchar('\\');
+            putchar(*p);
+        } else if (*p < 32) {
+            printf("\\u%04x", *p);
+        } else {
+            putchar(*p);
+        }
+    }
+    putchar('"');
+}
