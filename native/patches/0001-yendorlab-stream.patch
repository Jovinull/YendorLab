 static void null_nextKeyOrMouseEvent(rogueEvent *returnEvent, boolean textInput, boolean colorsDance) {
+    if (!yendorLabMode) return;
+    (void)textInput;
+    // Upstream flushes the recording only on turn ends, so a long run of turnless
+    // inputs would overflow it and print a diagnostic into the observation stream.
+    // Flush only between commands: a prompt may still cancel the keystroke that opened
+    // it, and cancelKeystroke underflows the buffer position if that key already left.
+    if (yendorLabInputContext == 1 && locationInRecordingBuffer >= INPUT_RECORD_BUFFER) flushBufferToFile();
+    lab_observation();
+    char line[32];
+    if (!fgets(line, sizeof line, stdin)) exit(64);
+    char action = 0;
+    if (!strcmp(line, "ESC\n")) action = ESCAPE_KEY;
+    else if (!strcmp(line, "ENTER\n")) action = RETURN_KEY;
+    else if (line[0] && line[1] == '\n' && strchr("abcdefghijklmnopqrstuvwxyz<> QN", line[0])) action = line[0];
+    if (!action) {
+        fputs("{\"event\":\"protocol_error\",\"reason\":\"invalid_action\"}\n", stdout);
+        fflush(stdout);
+        exit(64);
+    }
+    returnEvent->eventType = KEYSTROKE;
+    returnEvent->param1 = action;
+    returnEvent->param2 = 0;
+    returnEvent->shiftKey = false;
+    returnEvent->controlKey = false;
     return;
 }
 
