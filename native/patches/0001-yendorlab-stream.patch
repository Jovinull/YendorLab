+        for (short x = 0; x < DCOLS; x++) {
+            for (short y = 0; y < DROWS; y++) {
+                for (short layer = 0; layer < NUMBER_TERRAIN_LAYERS; layer++) {
+                    short tile = pmap[x][y].layers[layer];
+                    if (!(tileCatalog[tile].mechFlags & TM_IS_SECRET)) continue;
+                    if (tile == SECRET_DOOR || tile == WALL_LEVER_HIDDEN) pmap[x][y].layers[layer] = WALL;
+                    else pmap[x][y].layers[layer] = layer == DUNGEON ? FLOOR : NOTHING;
+                }
+            }
+        }
+    }
+}
