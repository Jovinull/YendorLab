+        // Real item flows: the test drives apply/select through the normal UI.
+        const short scrolls[] = {SCROLL_MAGIC_MAPPING};
+        const short potions[] = {POTION_TELEPATHY, POTION_HALLUCINATION, POTION_DARKNESS, POTION_DETECT_MAGIC};
+        for (unsigned i = 0; i < sizeof scrolls / sizeof scrolls[0]; i++) {
+            item *it = generateItem(SCROLL, scrolls[i]);
+            identify(it);
+            addItemToPack(it);
+        }
+        for (unsigned i = 0; i < sizeof potions / sizeof potions[0]; i++) {
+            item *it = generateItem(POTION, potions[i]);
+            identify(it);
+            addItemToPack(it);
+        }
+        // A visible floor item, so the hallucination check cannot pass vacuously.
+        item *bait = generateItem(SCROLL, SCROLL_ENCHANTING);
+        for (short dir = 0; dir < 8; dir++) {
+            pos loc = {player.loc.x + nbDirs[dir][0], player.loc.y + nbDirs[dir][1]};
+            if (!cellHasTerrainFlag(loc, T_OBSTRUCTS_PASSABILITY) && !(pmapAt(loc)->flags & HAS_ITEM)) {
+                placeItemAt(bait, loc);
+                break;
+            }
+        }
+    } else if (!strcmp(yendorLabTestScenario, "perturb_hidden")
+               || !strcmp(yendorLabTestScenario, "deep_perturb_hidden")) {
+        // Same apparent world, different hidden truth: unseen item identity,
+        // unseen creature state, secret doors and hidden traps.
+        for (item *it = floorItems->nextItem; it; it = it->nextItem) {
+            if (!playerCanSee(it->loc.x, it->loc.y)) {
+                it->quantity += 1;
+                it->enchant1 += 3;
+                it->flags ^= ITEM_CURSED;
+            }
+        }
+        for (creatureIterator iter = iterateCreatures(monsters); hasNextCreature(iter);) {
