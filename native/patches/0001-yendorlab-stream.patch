+                          yendorLabInputContext == 6 ? "target_selection" :
+                          yendorLabInputContext == 7 ? "text_input" : "unknown";
+    printf("{\"protocol\":3,\"observation_schema\":3,\"action_schema\":2,\"decision\":%lu,\"context\":\"%s\",\"seed\":%llu,\"depth\":%d,\"turn\":%lu,\"x\":%d,\"y\":%d,\"hp\":%d,\"max_hp\":%d,\"width\":%d,\"height\":%d,\"admissible\":[",
+           ++labDecision, context,
+           (unsigned long long) rogue.seed, rogue.depthLevel,
+           (unsigned long) rogue.absoluteTurnNumber, player.loc.x, player.loc.y,
+           player.currentHP, player.info.maxHP, DCOLS, DROWS);
+    const char *keys = yendorLabInputContext == 1 ? "hjklyubnz<>siaerQ" :
+                       yendorLabInputContext == 2 ? "" :
+                       yendorLabInputContext == 3 ? "yN" :
+                       yendorLabInputContext == 6 ? "hjklyubn" :
+                       yendorLabInputContext == 4 || yendorLabInputContext == 5 ? " " : "";
+    boolean first = true;
+    for (const char *key = keys; *key; key++) {
+        printf("%s\"%c\"", first ? "" : ",", *key);
+        first = false;
+    }
+    if (yendorLabInputContext == 2) {
+        for (item *it = packItems->nextItem; it; it = it->nextItem) {
+            printf("%s\"%c\"", first ? "" : ",", it->inventoryLetter);
+            first = false;
+        }
+    }
+    if (yendorLabInputContext == 7 || yendorLabInputContext == 2 || yendorLabInputContext == 3 || yendorLabInputContext == 4 || yendorLabInputContext == 5 || yendorLabInputContext == 6) {
+        printf("%s\"ESC\"", first ? "" : ",");
+        first = false;
+    }
+    if (yendorLabInputContext == 7 || yendorLabInputContext == 6) printf("%s\"ENTER\"", first ? "" : ",");
+    printf("],\"cells\":[");
+    first = true;
+    for (short x = 0; x < DCOLS; x++) {
+        for (short y = 0; y < DROWS; y++) {
+            boolean visible = playerCanSee(x, y);
+            if (!visible && !(pmap[x][y].flags & (DISCOVERED | MAGIC_MAPPED))) continue;
+            enum displayGlyph glyph = pmap[x][y].rememberedAppearance.character;
+            if (visible || !(pmap[x][y].flags & STABLE_MEMORY)) {
+                color foreground, background;
+                getCellAppearance((pos){x, y}, &glyph, &foreground, &background);
+            }
+            unsigned long knownFlags = pmap[x][y].rememberedTerrainFlags;
+            if (visible) getLocationFlags(x, y, &knownFlags, NULL, NULL, true);
+            boolean blocked = !!(knownFlags & T_OBSTRUCTS_PASSABILITY);
+            if (visible && cellHasTMFlag((pos){x, y}, TM_IS_SECRET)) {
+                blocked = lab_glyph_blocks(glyph);
+            }
+            printf("%s[%d,%d,%d,%d,%d,%d]", first ? "" : ",", x, y,
+                   visible ? 1 : 0, glyph, blocked,
+                   glyph == G_DOWN_STAIRS ? 1 : glyph == G_UP_STAIRS ? -1 : 0);
+            first = false;
+        }
+    }
+    printf("],\"inventory\":[");
+    first = true;
+    for (item *it = packItems->nextItem; it; it = it->nextItem) {
+        char name[COLS * 5];
+        itemName(it, name, true, false, NULL);
+        printf("%s{\"letter\":\"%c\",\"category\":%u,\"quantity\":%d,\"equipped\":%s,\"name\":",
+               first ? "" : ",", it->inventoryLetter, it->category, it->quantity,
+               it->flags & ITEM_EQUIPPED ? "true" : "false");
+        lab_string(name);
+        putchar('}');
+        first = false;
+    }
+    printf("],\"floor_items\":[");
+    first = true;
+    for (item *it = floorItems->nextItem; it; it = it->nextItem) {
+        if (!playerCanSee(it->loc.x, it->loc.y)) continue;
+        char name[COLS * 5];
+        describedItemName(it, name, COLS * 5 - 1);
+        printf("%s{\"x\":%d,\"y\":%d,\"name\":", first ? "" : ",", it->loc.x, it->loc.y);
+        lab_string(name);
+        putchar('}');
+        first = false;
+    }
+    printf("],\"creatures\":[");
+    first = true;
+    for (creatureIterator iter = iterateCreatures(monsters); hasNextCreature(iter);) {
+        creature *it = nextCreature(&iter);
+        if (!canSeeMonster(it)) continue;
