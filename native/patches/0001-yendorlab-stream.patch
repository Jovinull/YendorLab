+                it->loc.x, it->loc.y, playerCanSee(it->loc.x, it->loc.y) ? 1 : 0, name);
+        first = false;
+    }
+    fputs("],\"secrets\":[", out);
+    first = true;
+    for (short x = 0; x < DCOLS; x++) {
+        for (short y = 0; y < DROWS; y++) {
+            if (cellHasTMFlag((pos){x, y}, TM_IS_SECRET)) {
+                fprintf(out, "%s[%d,%d,%d]", first ? "" : ",", x, y,
+                        cellHasTerrainFlag((pos){x, y}, T_OBSTRUCTS_PASSABILITY) ? 1 : 0);
+                first = false;
+            }
+        }
+    }
+    fputs("]}\n", out);
+    fflush(out);
+}
